.DS_Store

# Generated by xcodegen — never committed. Run `make generate`.
*.xcodeproj
*.xcworkspace
Sources/Currawong/Info.plist
Sources/CurrawongLiveActivity/Info.plist

# Build products
.build/
DerivedData/
build/

# The app builds and embeds no XCFramework since APP-31 removed
# Codec2.xcframework. The rule stays as a guard: redistributing a third-party
# binary from this repository is a decision nobody has taken, and a stray
# Codec2.xcframework left over from a pre-APP-31 checkout should not be
# committable by accident. See docs/CODEC2.md.
*.xcframework

# Per-user Xcode state
xcuserdata/
*.xcuserstate
.swiftpm/

# Claude Code session state and worktrees
.claude/

# Coverage counters dropped in the working tree by an instrumented run.
default.profraw
*.profraw
